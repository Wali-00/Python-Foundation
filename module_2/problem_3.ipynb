   "source": [
    "n = int(input())\n",
    "for i in range(n):\n",
    "    inp =int(input())\n",
    "    while inp>0:\n",
    "    \n",
    "        print(inp%10, end=\" \")\n",
    "        inp//=10\n",
    "    print()    \n",
    "\n"
   ]
